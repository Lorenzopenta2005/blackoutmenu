# BlackOut Pub — Menu Cibo & Drink
# Copia questo file come .env e compila i valori

PORT=3002
ADMIN_PASSWORD=metti_una_password_forte_qui

# Percorso segreto per accedere al pannello admin (es. admin-x7k2m9)
# Solo chi conosce questo path può vedere la pagina di login admin
ADMIN_SECRET_PATH=admin-panel

SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_KEY=your-service-role-key-here
