<script>
$('#pulsante-shop').click(function() {
  window.location.href = "/shop";
});

$(document).ready(function() {
    let tricksCursor = document.querySelector('.cursor');
    window.addEventListener('mousemove', cursor);

    function cursor(e) {
        tricksCursor.style.top = e.clientY + 'px';
        tricksCursor.style.left = e.clientX + 'px';
    }

    // Adjust cursor size and position on hover of elements with the "dynamic-hover" class
    $('.dynamic-hover').mouseenter(function() {
        window.removeEventListener("mousemove", cursor);

        var width = $(this).outerWidth();
        var height = $(this).outerHeight();
        var tricksTop = $(this).offset().top - $(document).scrollTop();
        var tricksLeft = $(this).offset().left;

        $('.cursor').css({
            'top': (tricksTop + height / 2) + 'px',
            'left': (tricksLeft + width / 2) + 'px',
            'width': width + 'px',
            'height': height + 'px'
        });
    });

    $('.dynamic-hover').mouseleave(function() {
        window.addEventListener("mousemove", cursor);
        $('.cursor').css({
            'width': '', // Reset to default or original width
            'height': '' // Reset to default or original height
        });
    });
});
</script>




<!-- CODICE PER IL BANNER DELLA MAGGIORE ETà -->
<script data-iub-purposes="essential" data-iub-resume-function="true">
  function setCookie(name, value, days) {
    const date = new Date();
    date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
    document.cookie = name + "=" + value + "; expires=" + date.toUTCString() + "; path=/";
  }

  function getCookie(name) {
    const cname = name + "=";
    const decodedCookie = decodeURIComponent(document.cookie);
    const cookies = decodedCookie.split(';');
    for (let i = 0; i < cookies.length; i++) {
      let c = cookies[i].trim();
      if (c.indexOf(cname) === 0) {
        return c.substring(cname.length, c.length);
      }
    }
    return "";
  }

  document.addEventListener('DOMContentLoaded', function() {
    const ageGateEl = document.querySelector('[ms-code-agegate]');
    const isAgeVerified = getCookie('ms-code-ageVerified') === 'true';

    // Se il cookie NON è presente, mostra il popup
    if (!isAgeVerified && ageGateEl) {
      document.body.classList.add('show-agegate');
    }

    document.addEventListener('click', function(event) {
      if (event.target.closest('[ms-code-click="confirmAge"]')) {
        setCookie('ms-code-ageVerified', 'true', 365);
        document.body.classList.remove('show-agegate');
      } else if (event.target.closest('[ms-code-click="denyAge"]')) {
        window.location.href = '/accesso-negato';
      }
    });
  });
</script><script>
  document.addEventListener("DOMContentLoaded", function () {
    const cartButtons = document.querySelectorAll('[data-cart="true"]');

    cartButtons.forEach(cart => {
      const label = cart.querySelector('[data-stock-label="true"]');

      function updateStockLabel() {
        if (cart.classList.contains("sf-out-of-stock")) {
          if (label) label.textContent = "OUT OF STOCK";
        } else {
          if (label) label.textContent = "ACQUISTA ORA";
        }
      }

      // Controllo iniziale
      updateStockLabel();

      // Observer per cambi di classi
      const observer = new MutationObserver(mutations => {
        mutations.forEach(mutation => {
          if (mutation.attributeName === "class") {
            updateStockLabel();
          }
        });
      });

      observer.observe(cart, { attributes: true });
    });
  });
</script>
